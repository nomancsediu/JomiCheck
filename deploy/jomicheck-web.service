[Unit]
Description=JomiCheck Next.js frontend
After=network.target jomicheck-api.service

[Service]
User=ubuntu
WorkingDirectory=/opt/jomicheck/frontend
Environment=NODE_ENV=production
ExecStart=/opt/jomicheck/frontend/node_modules/.bin/next start --hostname 127.0.0.1 --port 3000
Restart=always

[Install]
WantedBy=multi-user.target
