# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Report assistant and document reader: Gemma via Google AI Studio (called through the google-genai SDK).
# Any other OpenAI-compatible server (e.g. Ollama at http://localhost:11434/v1) also works.
# Get a key at https://aistudio.google.com/apikey
# List available Gemma models with: python manage.py check_llm --list
LLM_API_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemma-4-26b-a4b-it
